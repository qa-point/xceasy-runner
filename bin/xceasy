#!/bin/bash
set -euo pipefail

runner_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
. "$runner_root/scripts/lib/environment.sh"
version=$(jq -r '.version' "$runner_root/release-metadata.json")

usage() {
    cat <<'EOF'
Usage:
  xceasy test [--config FILE] [selection and execution options]
  xceasy validate-config [FILE]
  xceasy version

The default config is ./xceasy-runner.json.

Selection options:
  --annotation NAME          Include tests matching any repeated marker (OR)
  --require-annotation NAME  Require every repeated marker (AND)
  --exclude-annotation NAME  Exclude tests with this marker (highest priority)

Execution options:
  --mode shard|replicate
  --simulator ID             Replace configured devices with simulator IDs; repeatable
  --physical-device ID       Replace configured devices with physical device IDs; repeatable
  --device ID                Legacy alias for --simulator
  --output-directory PATH
  --state-isolation none|app-reset-hook
  --test-plan NAME           Use a test plan associated with the scheme
  --test-configuration NAME  Run exactly one configuration from that plan
  --no-recovery
  --plan-only
EOF
}

command_name=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi

case "$command_name" in
    help|-h|--help)
        usage
        ;;
    version|--version|-v)
        echo "xceasy-runner $version"
        ;;
    validate-config)
        config=${1:-xceasy-runner.json}
        "$runner_root/scripts/validate-config.sh" "$config"
        echo "Configuration is valid: $config"
        ;;
    test)
        resolve_xcode_developer_dir
        config=xceasy-runner.json
        plan_only=false
        mode_override=
        output_override=
        isolation_override=
        test_plan_override=
        test_configuration_override=
        no_recovery=false
        include_any='[]'
        include_all='[]'
        exclude='[]'
        devices='[]'
        has_selection_override=false
        has_device_override=false

        while [ "$#" -gt 0 ]; do
            case "$1" in
                --config)
                    [ "$#" -ge 2 ] || { echo "Missing value for --config" >&2; exit 64; }
                    config=$2
                    shift 2
                    ;;
                --annotation|--require-annotation|--exclude-annotation|--device|--simulator|--physical-device)
                    option=$1
                    [ "$#" -ge 2 ] || { echo "Missing value for $option" >&2; exit 64; }
                    value=$2
                    [ -n "$value" ] || { echo "Empty value for $option" >&2; exit 64; }
                    case "$option" in
                        --annotation) include_any=$(jq -nc --argjson current "$include_any" --arg value "$value" '$current + [$value] | unique') ;;
                        --require-annotation) include_all=$(jq -nc --argjson current "$include_all" --arg value "$value" '$current + [$value] | unique') ;;
                        --exclude-annotation) exclude=$(jq -nc --argjson current "$exclude" --arg value "$value" '$current + [$value] | unique') ;;
                        --device|--simulator) devices=$(jq -nc --argjson current "$devices" --arg value "$value" '$current + [{type: "simulator", id: $value}] | unique') ;;
                        --physical-device) devices=$(jq -nc --argjson current "$devices" --arg value "$value" '$current + [{type: "physical", id: $value}] | unique') ;;
                    esac
                    case "$option" in
                        --device|--simulator|--physical-device) has_device_override=true ;;
                        *) has_selection_override=true ;;
                    esac
                    shift 2
                    ;;
                --mode)
                    [ "$#" -ge 2 ] || { echo "Missing value for --mode" >&2; exit 64; }
                    mode_override=$2
                    shift 2
                    ;;
                --output-directory)
                    [ "$#" -ge 2 ] || { echo "Missing value for --output-directory" >&2; exit 64; }
                    output_override=$2
                    shift 2
                    ;;
                --state-isolation)
                    [ "$#" -ge 2 ] || { echo "Missing value for --state-isolation" >&2; exit 64; }
                    case "$2" in none|app-reset-hook) ;; *) echo "Invalid state isolation mode: $2" >&2; exit 64 ;; esac
                    isolation_override=${2//-/_}
                    shift 2
                    ;;
                --test-plan)
                    [ "$#" -ge 2 ] || { echo "Missing value for --test-plan" >&2; exit 64; }
                    test_plan_override=$2
                    shift 2
                    ;;
                --test-configuration)
                    [ "$#" -ge 2 ] || { echo "Missing value for --test-configuration" >&2; exit 64; }
                    test_configuration_override=$2
                    shift 2
                    ;;
                --no-recovery)
                    no_recovery=true
                    shift
                    ;;
                --plan-only)
                    plan_only=true
                    shift
                    ;;
                -h|--help)
                    usage
                    exit 0
                    ;;
                *)
                    echo "Unknown option: $1" >&2
                    usage >&2
                    exit 64
                    ;;
            esac
        done

        "$runner_root/scripts/validate-config.sh" "$config"
        config_base_directory=$(CDPATH= cd -- "$(dirname "$config")" && pwd)
        temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/xceasy-runner-cli.XXXXXX")
        trap 'rm -rf "$temporary_directory"' EXIT
        effective_config="$temporary_directory/config.json"
        jq \
            --arg mode "$mode_override" \
            --arg output "$output_override" \
            --arg isolation "$isolation_override" \
            --arg test_plan "$test_plan_override" \
            --arg test_configuration "$test_configuration_override" \
            --argjson no_recovery "$no_recovery" \
            --argjson selection_override "$has_selection_override" \
            --argjson include_any "$include_any" \
            --argjson include_all "$include_all" \
            --argjson exclude "$exclude" \
            --argjson device_override "$has_device_override" \
            --argjson devices "$devices" '
                if $mode != "" then .mode = $mode else . end
                | if $output != "" then .output_directory = $output else . end
                | if $isolation != "" then
                    .state_isolation = $isolation
                  else . end
                | if $test_plan != "" or $test_configuration != "" then
                    if $test_plan != "" then .test_plan = $test_plan else . end
                    | if $test_configuration != "" then .test_configuration = $test_configuration else . end
                  else . end
                | if $no_recovery then .retry_missing_tests = false else . end
                | if $selection_override then .selection = {
                    include_any: $include_any,
                    include_all: $include_all,
                    exclude: $exclude
                  } else . end
                | if $device_override then
                    .devices = $devices
                  else . end
            ' "$config" > "$effective_config"
        "$runner_root/scripts/validate-config.sh" "$effective_config"
        if [ "$plan_only" = true ]; then
            XC_EASY_CONFIG_BASE_DIRECTORY="$config_base_directory" \
                "$runner_root/scripts/run-multidevice-tests.sh" "$effective_config" --plan-only
        else
            XC_EASY_CONFIG_BASE_DIRECTORY="$config_base_directory" \
                "$runner_root/scripts/run-multidevice-tests.sh" "$effective_config"
        fi
        ;;
    *)
        echo "Unknown command: $command_name" >&2
        usage >&2
        exit 64
        ;;
esac
