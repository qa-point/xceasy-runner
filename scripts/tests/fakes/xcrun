#!/bin/sh
set -eu

if [ "$#" -eq 1 ] && [ "$1" = "swift-demangle" ]; then
    cat
    exit 0
fi

if [ "$#" -eq 4 ] && [ "$1" = "simctl" ] && [ "$2" = "list" ] && [ "$3" = "devices" ] && [ "$4" = "--json" ]; then
    jq -n '{
        devices: {
            "com.apple.CoreSimulator.SimRuntime.iOS-18-0": [
                {udid: "device-1", name: "Stress 1", state: "Shutdown", isAvailable: true},
                {udid: "device-2", name: "Stress 2", state: "Shutdown", isAvailable: true},
                {udid: "device-3", name: "Stress 3", state: "Shutdown", isAvailable: true},
                {udid: "device-4", name: "Stress 4", state: "Shutdown", isAvailable: true}
            ]
        }
    }'
    exit 0
fi

echo "Unexpected fake xcrun invocation: $*" >&2
exit 64
